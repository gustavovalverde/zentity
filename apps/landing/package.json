  "scripts": {
    "dev": "react-router dev",
    "build": "node scripts/sync-docs.js && node scripts/sync-mcp-tool-manifest.js && react-router build && node scripts/fix-vite-manifest.js",
    "lint": "biome check . --write",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "type-check": "react-router typegen && tsc -b",
    "knip": "knip --production",
    "check-all": "pnpm run type-check && pnpm run lint:check && pnpm run knip",
    "fix-all": "pnpm run type-check && pnpm run lint",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
