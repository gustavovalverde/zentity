    "@fontsource-variable/manrope": "^5.3.0",
    "@react-router/node": "^7.18.5",
    "@tabler/icons-react": "^3.51.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.18.4",
    "fumadocs-mdx": "^15.5.3",
    "fumadocs-ui": "^16.18.4",
    "isbot": "^5.2.2",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
