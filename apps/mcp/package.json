{
  "name": "@zentity/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "zentity-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:sdk": "pnpm --filter @zentity/sdk build",
    "dev": "pnpm run build:sdk >&2 && tsx src/index.ts",
    "build": "pnpm run build:sdk && tsup src/index.ts --format esm --target node24 --clean --out-dir dist",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http",
    "lint": "pnpm exec ultracite fix",
    "lint:check": "pnpm exec ultracite check",
    "lint:fix": "pnpm exec ultracite fix",
    "typecheck": "pnpm run build:sdk && tsc --noEmit",
    "test": "pnpm run build:sdk && vitest run",
    "test:e2e": "pnpm run build:sdk && tsx scripts/e2e-smoke.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.8.0-beta.10",
    "@better-auth/mcp": "1.8.0-beta.10",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/server": "2.4.0",
    "@zentity/sdk": "workspace:*",
    "better-auth": "1.8.0-beta.10",
    "better-call": "1.4.5",
    "hono": "^4.13.17",
    "jose": "^6.2.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1",
    "vitest": "^5.1.0"
  }
}
