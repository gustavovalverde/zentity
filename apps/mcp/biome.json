{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": [
      "src/**",
      "__tests__/**",
      "*.ts",
      "*.mts",
      "!!node_modules",
      "!!dist",
      "!!.data"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "useConsistentMethodSignatures": "off",
        "noIncrementDecrement": "off",
        "useDestructuring": "off",
        "useUnicodeRegex": "off",
        "useImportsFirst": "off"
      },
      "performance": {
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        "noEqualsToNull": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedPackageJson": "off",
        "useSortedKeys": "off"
      }
    }
  }
}
