{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "linter": {
    "domains": {
      "next": "recommended"
    },
    "rules": {
      "correctness": {
        "noUnsafeOptionalChaining": "off"
      },
      "style": {
        "useConsistentMethodSignatures": "off",
        "useConsistentArrowReturn": "off",
        "useNamedCaptureGroup": "off",
        "noIncrementDecrement": "off",
        "useDestructuring": "off",
        "useUnicodeRegex": "off",
        "useImportsFirst": "off",
        "useErrorCause": "off",
        "noSubstr": "off"
      },
      "suspicious": {
        "noUnnecessaryConditions": "off",
        "noJsxLeakedDollar": "off",
        "noLeakedRender": "off",
        "noEqualsToNull": "off",
        "noShadow": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": "off"
      },
      "performance": {
        "noJsxPropsBind": "off"
      }
    }
  },
  "files": {
    "includes": [
      "src/**",
      "e2e/**",
      "scripts/**",
      "*.ts",
      "*.mts",
      "!!node_modules",
      "!!public",
      "!!.next",
      "!!.data",
      "!!playwright-report",
      "!!test-results"
    ]
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noNoninteractiveElementInteractions": "off",
            "noSvgWithoutTitle": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "style": {
            "useImportType": "off",
            "noNestedTernary": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noShadow": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/app/exchange/_components/**/*.tsx",
        "src/app/wine/_components/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noSvgWithoutTitle": "off"
          },
          "style": {
            "noNestedTernary": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/**/page.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNestedTernary": "off"
          }
        }
      }
    }
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "useSortedPackageJson": "off",
        "useSortedKeys": "off"
      }
    }
  }
}
