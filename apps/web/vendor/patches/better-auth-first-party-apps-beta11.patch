@@ -0,0 +1,77 @@
+import { defineErrorCodes } from "@better-auth/core/utils/error-codes";
+import { APIError } from "better-auth/api";
+
+/** Error descriptions for the Authorization Challenge Endpoint (draft §5.2.2). */
+export const FIRST_PARTY_APPS_ERROR_CODES = defineErrorCodes({
+	FORM_ENCODING_REQUIRED:
+		"The initial request must use application/x-www-form-urlencoded",
+	RESPONSE_TYPE_REQUIRED: "response_type is required",
+	UNSUPPORTED_RESPONSE_TYPE: "response_type must be code",
+	REQUEST_URI_NOT_ACCEPTED: "request_uri is not accepted at this endpoint",
+	REQUEST_OBJECT_NOT_SUPPORTED: "request object not supported",
+	REDIRECT_URI_NOT_ACCEPTED:
+		"redirect_uri is not accepted: the authorization code is returned directly",
+	CREDENTIAL_BEFORE_CHALLENGE:
+		"A credential can only answer a challenge from an auth_session",
+	UNEXPECTED_PARAMETERS:
+		"Authorization request parameters cannot change while a challenge is waiting for a response",
+	RESPONSE_REQUIRED: "The request must answer the pending challenge",
+	LOGIN_REQUIRED: "The user must sign in",
+	BROWSER_REQUIRED: "The user must continue in the browser",
+	NOT_FIRST_PARTY:
+		"The client may not use the authorization challenge endpoint",
+	INVALID_SESSION: "The auth_session is invalid, expired, or already in use",
+	CLIENT_MISMATCH: "client_id does not match the auth_session",
+	DPOP_NOT_EXPECTED: "The auth_session is not bound to a DPoP key",
+	AUTHENTICATION_FAILED: "The credential is not valid",
+	ACCOUNT_CANNOT_SIGN_IN: "The account cannot sign in",
+	SCOPE_EXCEEDS_GRANT: "The requested scope exceeds the grant",
+	RESOURCE_EXCEEDS_GRANT: "The requested resource exceeds the grant",
+	CLAIMS_EXCEED_GRANT: "The claims request cannot change for this grant",
+	STEP_UP_REQUIRED: "Additional authorization is required",
+});
+
+// Draft §5.2.2: error_description is limited to %x20-21 / %x23-5B / %x5D-7E.
+const FORBIDDEN_DESCRIPTION_CHARACTERS = /[^\x20\x21\x23-\x5B\x5D-\x7E]/g;
+
+function sanitizeDescription(
+	description: string | undefined,
+): string | undefined {
+	if (description === undefined) return undefined;
+	const sanitized = description.replace(FORBIDDEN_DESCRIPTION_CHARACTERS, "");
+	return sanitized || undefined;
+}
+
+type ErrorStatus = "BAD_REQUEST" | "FORBIDDEN";
+
+/** Throws a draft §5.2.2 error response. Fields are top-level JSON members. */
+export function challengeError(
+	status: ErrorStatus,
+	error: string,
+	description?: string,
+	fields?: Record<string, unknown>,
+	headers?: Record<string, string> | Headers,
+): never {
+	const errorDescription = sanitizeDescription(description);
+	throw new APIError(
+		status,
+		{
+			...fields,
+			error,
+			...(errorDescription ? { error_description: errorDescription } : {}),
+		},
+		headers,
+	);
+}
+
+export function invalidRequest(description: string): never {
+	return challengeError("BAD_REQUEST", "invalid_request", description);
+}
+
+export function invalidSession(): never {
+	return challengeError(
+		"BAD_REQUEST",
+		"invalid_session",
+		FIRST_PARTY_APPS_ERROR_CODES.INVALID_SESSION.message,
+	);
+}
diff --git a/packages/first-party-apps/src/failure-budget.ts b/packages/first-party-apps/src/failure-budget.ts
new file mode 100644
index 0000000..8085557
--- /dev/null
+++ b/packages/first-party-apps/src/failure-budget.ts
@@ -0,0 +1,108 @@
+import type { GenericEndpointContext } from "@better-auth/core";
+import { createHMAC } from "@better-auth/utils/hmac";
+import type {
+	FirstPartyFailureBudget,
+	ResolvedFirstPartyAppsOptions,
+} from "./types";
+
+const BUDGET_MODEL = "firstPartyFailureBudget";
+
+/**
+ * The budget key for a method and an account, or for the hint when the
+ * account is unknown. A keyed hash, so the table holds no identifier in the
+ * clear.
+ */
+export async function getBudgetKey(
+	ctx: GenericEndpointContext,
+	methodId: string,
+	subject: { userId: string } | { loginHint: string },
+): Promise<string> {
+	const value =
+		"userId" in subject
+			? `user:${subject.userId}`
+			: `hint:${subject.loginHint.trim().toLowerCase()}`;
+	return createHMAC("SHA-256", "base64urlnopad").sign(
+		ctx.context.secret,
+		`first-party-apps:failure-budget:${methodId}:${value}`,
+	);
+}
+
+/**
+ * Counts one failure before the method checks the credential, so requests
+ * that run concurrently cannot check more credentials than the budget allows.
+ * Returns false, and counts nothing, when the account is locked. A response
+ * that turns out not to fail gives its failure back with `releaseBudgetFailure`.
+ */
+export async function reserveBudgetFailure(
+	ctx: GenericEndpointContext,
+	options: ResolvedFirstPartyAppsOptions,
+	key: string,
+): Promise<boolean> {
+	if (!options.failureBudget) return true;
+	const { maxFailures, window } = options.failureBudget;
+	const { adapter } = ctx.context;
+	for (let attempt = 0; attempt < 3; attempt++) {
+		const now = new Date();
+		const reserved = await adapter.incrementOne({
+			model: BUDGET_MODEL,
+			where: [
+				{ field: "key", value: key },
+				{ field: "resetAt", operator: "gt", value: now },
+				{ field: "failures", operator: "lt", value: maxFailures },
+			],
+			increment: { failures: 1 },
+		});
+		if (reserved) return true;
+		const budget = await adapter.findOne<FirstPartyFailureBudget>({
+			model: BUDGET_MODEL,
+			where: [{ field: "key", value: key }],
+		});
+		const resetAt = new Date(now.getTime() + window * 1000);
+		if (!budget) {
+			try {
+				await adapter.create({
+					model: BUDGET_MODEL,
+					data: { key, failures: 1, resetAt },
+				});
+				return true;
+			} catch {
+				// A concurrent request created the row first.
+				continue;
+			}
+		}
+		if (new Date(budget.resetAt) > now) {
+			if (budget.failures >= maxFailures) return false;
+			continue;
+		}
+		// The window passed. Only one of the requests that saw it pass restarts it.
+		const restarted = await adapter.incrementOne({
+			model: BUDGET_MODEL,
+			where: [
+				{ field: "key", value: key },
+				{ field: "resetAt", operator: "lte", value: now },
+				{ field: "failures", value: budget.failures },
+			],
+			increment: { failures: 1 - budget.failures },
+			set: { resetAt },
+		});
+		if (restarted) return true;
+	}
+	return false;
+}
+
+/** Gives back a failure `reserveBudgetFailure` counted for a response that did not fail. */
+export async function releaseBudgetFailure(
+	ctx: GenericEndpointContext,
+	options: ResolvedFirstPartyAppsOptions,
+	key: string,
+): Promise<void> {
+	if (!options.failureBudget) return;
+	await ctx.context.adapter.incrementOne({
+		model: BUDGET_MODEL,
+		where: [
+			{ field: "key", value: key },
+			{ field: "failures", operator: "gt", value: 0 },
+		],
+		increment: { failures: -1 },
+	});
+}
diff --git a/packages/first-party-apps/src/index.ts b/packages/first-party-apps/src/index.ts
new file mode 100644
index 0000000..993059f
--- /dev/null
+++ b/packages/first-party-apps/src/index.ts
@@ -0,0 +1,297 @@
+import type { AuthContext, GenericEndpointContext } from "@better-auth/core";
+import { BetterAuthError } from "@better-auth/core/error";
+import type {
+	OAuthOptions,
+	OAuthProviderExtension,
+	Scope,
+	VerificationValue,
+} from "@better-auth/oauth-provider";
+import { extendOAuthProvider } from "@better-auth/oauth-provider";
+import { getAuthEndpointUrl } from "@better-auth/oauth-provider/internal";
+import type { BetterAuthPlugin } from "better-auth";
+import { mergeSchema } from "better-auth/db";
+import { AUTH_SESSION_MODEL, rotateAuthSessionHandle } from "./auth-session";
+import {
+	AUTHORIZE_CHALLENGE_PATH,
+	createAuthorizeChallengeEndpoint,
+	OWNED_PARAMETERS,
+} from "./endpoint";
+import { FIRST_PARTY_APPS_ERROR_CODES } from "./error-codes";
+import { schema } from "./schema";
+import type {
+	FirstPartyAppsOptions,
+	FirstPartyAuthSession,
+	ResolvedFirstPartyAppsOptions,
+} from "./types";
+
+declare module "@better-auth/core" {
+	interface BetterAuthPluginRegistry<AuthOptions, Options> {
+		"first-party-apps": {
+			creator: typeof firstPartyApps;
+		};
+	}
+}
+
+export { FIRST_PARTY_APPS_ERROR_CODES } from "./error-codes";
+export { passwordMethod } from "./password";
+export { schema } from "./schema";
+export {
+	challengeFirstPartyStepUp,
+	challengeFirstPartyStepUpFromIssuance,
+} from "./step-up";
+export type {
+	FirstPartyAppsOptions,
+	FirstPartyAppsSchemaOptions,
+	FirstPartyAuthorizationDecision,
+	FirstPartyAuthorizationPolicyInput,
+	FirstPartyAuthorizationRequest,
+	FirstPartyAuthSession,
+	FirstPartyClient,
+	FirstPartyMethod,
+	FirstPartyMethodRespondInput,
+	FirstPartyMethodRespondResult,
+	FirstPartyMethodStartInput,
+	FirstPartyMethodStartResult,
+	FirstPartySessionFieldsInput,
+	FirstPartyStepUpFromIssuanceInput,
+	FirstPartyStepUpInput,
+} from "./types";
+
+const TOKEN_RESPONSE_COMPOSED = Symbol.for(
+	"better-auth.first-party-apps.token-response",
+);
+
+/**
+ * The Authorization Challenge Endpoint of OAuth 2.0 for First-Party
+ * Applications for `oauthProvider()`: a native or command-line app your
+ * organization ships signs a user in without a browser redirect, through
+ * pluggable credential methods, and redeems the code at the token endpoint.
+ *
+ * Requires the `oauth-provider` plugin with the `authorization_code` grant.
+ *
+ * @see https://datatracker.ietf.org/doc/html/draft-ietf-oauth-first-party-apps-04
+ */
+export function firstPartyApps(options: FirstPartyAppsOptions) {
+	const resolved = resolveOptions(options);
+	const extension: OAuthProviderExtension = {
+		name: "first-party-apps",
+		// Draft §8.
+		metadata: ({ ctx }) => ({
+			authorization_challenge_endpoint: getAuthEndpointUrl(
+				ctx,
+				AUTHORIZE_CHALLENGE_PATH,
+			),
+		}),
+		tokenResponseFields: async (input) => {
+			if (
+				input.grantType !== "authorization_code" ||
+				!input.verificationValue
+			) {
+				return {};
+			}
+			const handle = await rotateHandleForCode(
+				input.ctx,
+				input.verificationValue,
+			);
+			return handle ? { auth_session: handle } : {};
+		},
+	};
+	return {
+		id: "first-party-apps",
+		options: resolved,
+		// `mergeSchema` applies overrides in place, so merge into a copy.
+		schema: mergeSchema(structuredClone(schema), options.schema),
+		init(ctx) {
+			const provider = ctx.getPlugin("oauth-provider");
+			if (!provider) {
+				throw new BetterAuthError(
+					'@better-auth/first-party-apps requires the "oauth-provider" plugin. Add it to your plugins array.',
+				);
+			}
+			const oauthOptions = provider.options as OAuthOptions<Scope[]>;
+			if (
+				oauthOptions.grantTypes &&
+				!oauthOptions.grantTypes.includes("authorization_code")
+			) {
+				throw new BetterAuthError(
+					"@better-auth/first-party-apps requires the authorization_code grant in oauthProvider({ grantTypes }).",
+				);
+			}
+			for (const method of resolved.methods) method.init?.(ctx);
+			warnOnInsecureBaseURL(ctx);
+			extendOAuthProvider(ctx, extension);
+			composeTokenResponse(ctx, oauthOptions);
+		},
+		endpoints: {
+			authorizeChallenge: createAuthorizeChallengeEndpoint(resolved),
+		},
+		rateLimit: [
+			{
+				pathMatcher: (path: string) => path === AUTHORIZE_CHALLENGE_PATH,
+				window: resolved.rateLimit.window,
+				max: resolved.rateLimit.max,
+			},
+		],
+		$ERROR_CODES: FIRST_PARTY_APPS_ERROR_CODES,
+	} satisfies BetterAuthPlugin;
+}
+
+function resolveOptions(
+	options: FirstPartyAppsOptions,
+): ResolvedFirstPartyAppsOptions {
+	if (typeof options?.isFirstPartyClient !== "function") {
+		throw new BetterAuthError(
+			"@better-auth/first-party-apps requires an `isFirstPartyClient` function.",
+		);
+	}
+	if (!options.methods?.length) {
+		throw new BetterAuthError(
+			"@better-auth/first-party-apps requires at least one method.",
+		);
+	}
+	const ids = new Set<string>();
+	const responseParameters = new Map<string, string>();
+	for (const method of options.methods) {
+		if (ids.has(method.id)) {
+			throw new BetterAuthError(
+				`@better-auth/first-party-apps: duplicate method id "${method.id}".`,
+			);
+		}
+		ids.add(method.id);
+		if (!method.responseParameters.length) {
+			throw new BetterAuthError(
+				`@better-auth/first-party-apps: method "${method.id}" needs at least one response parameter.`,
+			);
+		}
+		for (const name of method.responseParameters) {
+			if (OWNED_PARAMETERS.has(name)) {
+				throw new BetterAuthError(
+					`@better-auth/first-party-apps: method "${method.id}" cannot use the plugin's "${name}" parameter as a response parameter.`,
+				);
+			}
+			const owner = responseParameters.get(name);
+			if (owner) {
+				throw new BetterAuthError(
+					`@better-auth/first-party-apps: methods "${owner}" and "${method.id}" both use the response parameter "${name}".`,
+				);
+			}
+			responseParameters.set(name, method.id);
+		}
+	}
+	const budget = options.failureBudget;
+	return {
+		isFirstPartyClient: options.isFirstPartyClient,
+		methods: options.methods,
+		authorizationPolicy: options.authorizationPolicy,
+		requireDpop: options.requireDpop ?? false,
+		session: {
+			expiresIn: options.session?.expiresIn,
+			fields: options.session?.fields,
+		},
+		authSession: {
+			expiresIn: options.authSession?.expiresIn ?? 600,
+			maxFailures: options.authSession?.maxFailures ?? 3,
+			maxRequests: options.authSession?.maxRequests ?? 20,
+		},
+		failureBudget:
+			budget === false
+				? false
+				: {
+						maxFailures: budget?.maxFailures ?? 10,
+						window: budget?.window ?? 900,
+					},
+		rateLimit: {
+			window: options.rateLimit?.window ?? 60,
+			max: options.rateLimit?.max ?? 10,
+		},
+	};
+}
+
+/**
+ * Keeps `auth_session` reserved for the plugin while allowing applications to
+ * contribute other custom token response fields.
+ */
+function composeTokenResponse(
+	ctx: AuthContext,
+	oauthOptions: OAuthOptions<Scope[]>,
+): void {
+	const appFields = oauthOptions.customTokenResponseFields;
+	if (
+		appFields &&
+		(appFields as { [TOKEN_RESPONSE_COMPOSED]?: true })[TOKEN_RESPONSE_COMPOSED]
+	) {
+		return;
+	}
+	let warned = false;
+	const composed: NonNullable<
+		OAuthOptions<Scope[]>["customTokenResponseFields"]
+	> = async (info) => {
+		const { auth_session: appValue, ...fields } = appFields
+			? await appFields(info)
+			: {};
+		if (appValue !== undefined && !warned) {
+			warned = true;
+			ctx.logger.warn(
+				"@better-auth/first-party-apps owns the auth_session token response field; the value from customTokenResponseFields is ignored.",
+			);
+		}
+		return fields;
+	};
+	Object.defineProperty(composed, TOKEN_RESPONSE_COMPOSED, { value: true });
+	oauthOptions.customTokenResponseFields = composed;
+}
+
+/**
+ * The provider has verified the token request's proof against the code and
+ * consumed the code when it builds the response, so the new handle goes to
+ * the holder of the row's key.
+ */
+async function rotateHandleForCode(
+	ctx: GenericEndpointContext,
+	verificationValue: VerificationValue,
+): Promise<string | null> {
+	const jkt = verificationValue.query.dpop_jkt;
+	const pluginContext = verificationValue.serverContext?.[
+		"first-party-apps"
+	] as { authSessionId?: unknown } | undefined;
+	if (
+		!jkt ||
+		!verificationValue.sessionId ||
+		typeof pluginContext?.authSessionId !== "string"
+	) {
+		return null;
+	}
+	if (!ctx.context.getPlugin("first-party-apps")) return null;
+	const row = await ctx.context.adapter.findOne<FirstPartyAuthSession>({
+		model: AUTH_SESSION_MODEL,
+		where: [{ field: "id", value: pluginContext.authSessionId }],
+	});
+	const now = new Date();
+	if (
+		!row ||
+		row.state !== "authenticated" ||
+		row.clientId !== verificationValue.query.client_id ||
+		row.sessionId !== verificationValue.sessionId ||
+		row.dpopJkt !== jkt ||
+		new Date(row.expiresAt) <= now
+	) {
+		return null;
+	}
+	return rotateAuthSessionHandle(ctx, row.id);
+}
+
+/** Draft §4.1: the endpoint must use `https`. */
+function warnOnInsecureBaseURL(ctx: AuthContext): void {
+	let url: URL;
+	try {
+		url = new URL(ctx.baseURL);
+	} catch {
+		return;
+	}
+	const loopback = ["localhost", "127.0.0.1", "[::1]"];
+	if (url.protocol === "http:" && !loopback.includes(url.hostname)) {
+		ctx.logger.warn(
+			"@better-auth/first-party-apps: the authorization challenge endpoint must be served over https (draft §4.1). Use an https baseURL in production.",
+		);
+	}
+}
diff --git a/packages/first-party-apps/src/password.ts b/packages/first-party-apps/src/password.ts
new file mode 100644
index 0000000..02fc94c
--- /dev/null
+++ b/packages/first-party-apps/src/password.ts
@@ -0,0 +1,81 @@
+import type { GenericEndpointContext } from "@better-auth/core";
+import type { Account, User } from "@better-auth/core/db";
+import { BetterAuthError } from "@better-auth/core/error";
+import * as z from "zod";
+import type { FirstPartyMethod } from "./types";
+
+const DEFAULT_MAX_PASSWORD_LENGTH = 128;
+
+/**
+ * Email and password sign-in for Better Auth credential accounts, checked as
+ * `/sign-in/email` checks them. The challenge carries no fields and looks the
+ * same for known and unknown addresses.
+ */
+export function passwordMethod(): FirstPartyMethod {
+	return {
+		id: "password",
+		amr: ["pwd"],
+		responseParameters: ["password"],
+		init(ctx) {
+			if (!ctx.options.emailAndPassword?.enabled) {
+				throw new BetterAuthError(
+					"passwordMethod() requires `emailAndPassword: { enabled: true }`.",
+				);
+			}
+		},
+		async start({ ctx, loginHint, user }) {
+			if (user) {
+				const account = await findCredentialAccount(ctx, user.id);
+				return account?.password
+					? { type: "challenge", userId: user.id }
+					: null;
+			}
+			if (!loginHint || !z.email().safeParse(loginHint).success) return null;
+			const found = await ctx.context.internalAdapter.findUserByEmail(
+				loginHint.toLowerCase(),
+			);
+			return { type: "challenge", userId: found?.user.id ?? null };
+		},
+		async respond({ ctx, userId, params }) {
+			const { password } = params;
+			if (typeof password !== "string" || !password) return { type: "failed" };
+			const maxLength =
+				ctx.context.options.emailAndPassword?.maxPasswordLength ??
+				DEFAULT_MAX_PASSWORD_LENGTH;
+			if (password.length > maxLength) return { type: "failed" };
+
+			const user = userId
+				? await ctx.context.internalAdapter.findUserById(userId)
+				: null;
+			const account = user ? await findCredentialAccount(ctx, user.id) : null;
+			if (!user || !account?.password) {
+				// Hash anyway, so an unknown account takes as long as a known one.
+				await ctx.context.password.hash(password);
+				return { type: "failed" };
+			}
+			const valid = await ctx.context.password.verify({
+				hash: account.password,
+				password,
+			});
+			if (!valid) return { type: "failed" };
+			if (
+				ctx.context.options.emailAndPassword?.requireEmailVerification &&
+				!user.emailVerified
+			) {
+				return { type: "redirect_to_web" };
+			}
+			return { type: "authenticated", userId: user.id };
+		},
+	};
+}
+
+async function findCredentialAccount(
+	ctx: GenericEndpointContext,
+	userId: User["id"],
+): Promise<Account | undefined> {
+	const accounts = await ctx.context.internalAdapter.findAccounts(userId);
+	return accounts.find(
+		(account) =>
+			account.providerId === "credential" && account.accountId === userId,
+	);
+}
diff --git a/packages/first-party-apps/src/schema.ts b/packages/first-party-apps/src/schema.ts
new file mode 100644
index 0000000..52a1200
--- /dev/null
+++ b/packages/first-party-apps/src/schema.ts
@@ -0,0 +1,141 @@
+import type { BetterAuthPluginDBSchema } from "@better-auth/core/db";
+
+/**
+ * `firstPartyAuthSession` holds one `auth_session` (draft §5.3.1).
+ * Lifecycle: `pending` until a credential proves the user, then
+ * `authenticated` while its backing session lives.
+ *
+ * `firstPartyFailureBudget` holds the per-account failure counters.
+ */
+export const schema = {
+	firstPartyAuthSession: {
+		fields: {
+			/**
+			 * HMAC-SHA-256 of the handle, keyed by the auth secret. The raw handle
+			 * is returned to the client and never stored.
+			 */
+			authSession: {
+				type: "string",
+				required: true,
+				unique: true,
+			},
+			clientId: {
+				type: "string",
+				required: true,
+				references: {
+					model: "oauthClient",
+					field: "clientId",
+					onDelete: "cascade",
+				},
+				index: true,
+			},
+			/**
+			 * Pending: the account the method's challenge is for, which no
+			 * credential has proven yet. Authenticated: the proven user.
+			 */
+			userId: {
+				type: "string",
+				required: false,
+				references: { model: "user", field: "id", onDelete: "cascade" },
+				index: true,
+			},
+			/** The backing session. Set exactly when the row is authenticated. */
+			sessionId: {
+				type: "string",
+				required: false,
+				references: { model: "session", field: "id", onDelete: "cascade" },
+				index: true,
+			},
+			/** Whether the plugin created `sessionId` for this flow. */
+			ownsSession: {
+				type: "boolean",
+				required: true,
+				defaultValue: false,
+			},
+			/** RFC 7638 thumbprint of the key the row is bound to. Never changes. */
+			dpopJkt: {
+				type: "string",
+				required: false,
+			},
+			/** `pending` or `authenticated`. */
+			state: {
+				type: "string",
+				required: true,
+			},
+			/** The method whose challenge is waiting for a response. */
+			method: {
+				type: "string",
+				required: false,
+			},
+			/**
+			 * The method's state, the flow's `login_hint`, and the parameters that
+			 * started the method, as JSON encrypted with the auth secret.
+			 */
+			methodState: {
+				type: "string",
+				required: false,
+			},
+			/** The authorization request as JSON, without client credentials. */
+			request: {
+				type: "string",
+				required: true,
+			},
+			/**
+			 * For a step-up row, the authorization the grant held, as JSON. Later
+			 * requests can narrow it but not widen it.
+			 */
+			ceiling: {
+				type: "string",
+				required: false,
+			},
+			/** What the backing session proved. */
+			amr: {
+				type: "string[]",
+				required: false,
+			},
+			/** Failed responses since the row's user last authenticated. */
+			failures: {
+				type: "number",
+				required: true,
+				defaultValue: 0,
+			},
+			/** Requests that advanced the row. Also the row's version for claims. */
+			attempts: {
+				type: "number",
+				required: true,
+				defaultValue: 0,
+			},
+			expiresAt: {
+				type: "date",
+				required: true,
+				index: true,
+			},
+			createdAt: {
+				type: "date",
+				required: true,
+			},
+			updatedAt: {
+				type: "date",
+				required: true,
+			},
+		},
+	},
+	firstPartyFailureBudget: {
+		fields: {
+			/** HMAC-SHA-256 of the method id and the account or hint. */
+			key: {
+				type: "string",
+				required: true,
+				unique: true,
+			},
+			failures: {
+				type: "number",
+				required: true,
+			},
+			resetAt: {
+				type: "date",
+				required: true,
+			},
+		},
+	},
+} satisfies BetterAuthPluginDBSchema;
diff --git a/packages/first-party-apps/src/step-up.ts b/packages/first-party-apps/src/step-up.ts
new file mode 100644
index 0000000..7c584d4
--- /dev/null
+++ b/packages/first-party-apps/src/step-up.ts
@@ -0,0 +1,287 @@
+import type { GenericEndpointContext } from "@better-auth/core";
+import { BetterAuthError } from "@better-auth/core/error";
+import type {
+	OAuthOptions,
+	Scope,
+} from "@better-auth/oauth-provider";
+import { getOAuthProviderApi } from "@better-auth/oauth-provider";
+import { toResourceList } from "@better-auth/oauth-provider/internal";
+import { NO_STORE_HEADERS } from "better-auth/api";
+import type { GrantCeiling } from "./auth-session";
+import {
+	AUTH_SESSION_MODEL,
+	createAuthSession,
+	findLiveSession,
+	rotateAuthSessionHandle,
+	rowExpiry,
+} from "./auth-session";
+import {
+	challengeError,
+	FIRST_PARTY_APPS_ERROR_CODES as ERRORS,
+} from "./error-codes";
+import type {
+	FirstPartyAuthorizationRequest,
+	FirstPartyAuthSession,
+	FirstPartyClient,
+	FirstPartyStepUpFromIssuanceInput,
+	FirstPartyStepUpInput,
+	ResolvedFirstPartyAppsOptions,
+} from "./types";
+
+/**
+ * Refuses a token request with HTTP 403 `insufficient_authorization` and an
+ * `auth_session` the client presents at the Authorization Challenge Endpoint
+ * to step up (draft §6.2). Resolves without side effects when the client
+ * cannot finish a step-up there; the caller then sends its own refusal.
+ *
+ * Call it only on a path that refuses the token request: it verifies the
+ * request's client and DPoP proof, which the token endpoint would otherwise
+ * verify again and reject as replayed.
+ */
+export async function challengeFirstPartyStepUp(
+	ctx: GenericEndpointContext,
+	input: FirstPartyStepUpInput,
+): Promise<void> {
+	const plugin = ctx.context.getPlugin("first-party-apps");
+	if (!plugin) {
+		throw new BetterAuthError(
+			"challengeFirstPartyStepUp requires the first-party-apps plugin.",
+		);
+	}
+	const options = plugin.options as ResolvedFirstPartyAppsOptions;
+	const oauthOptions = ctx.context.getPlugin("oauth-provider")!
+		.options as OAuthOptions<Scope[]>;
+	const provider = getOAuthProviderApi(ctx, oauthOptions);
+
+	const client = await provider.getClient(input.clientId);
+	if (!client || client.disabled || !allowsAuthorizationCode(client)) return;
+	if (!(await options.isFirstPartyClient({ client, ctx }))) return;
+	const live = input.sessionId
+		? await findLiveSession(ctx, input.sessionId)
+		: null;
+	const session = live?.session.userId === input.userId ? live.session : null;
+	if (
+		!session &&
+		input.dpopJkt === null &&
+		client.tokenEndpointAuthMethod === "none"
+	) {
+		return;
+	}
+
+	await provider.authenticateClient({
+		clientId: input.clientId,
+		requireCredentials: false,
+	});
+	const proof = await provider.verifyDpopProof(
+		input.dpopJkt !== null
+			? { expectedJkt: input.dpopJkt }
+			: {
+					required:
+						options.requireDpop || client.dpopBoundAccessTokens === true,
+				},
+	);
+	const dpopJkt = input.dpopJkt ?? proof?.jkt ?? null;
+	await createStepUpChallenge(ctx, options, {
+		client,
+		userId: input.userId,
+		sessionId: input.sessionId,
+		dpopJkt,
+		request: input.request,
+		description: input.description,
+		fields: input.fields,
+	});
+}
+
+/**
+ * Refuses an issuance that has already authenticated its client and checked
+ * its sender constraint. The supplied values come from the provider's
+ * beforeTokenIssuance hook, not from request parameters.
+ */
+export async function challengeFirstPartyStepUpFromIssuance(
+	input: FirstPartyStepUpFromIssuanceInput,
+): Promise<void> {
+	const { issuance } = input;
+	const { ctx, client, user } = issuance;
+	if (!user) return;
+	const plugin = ctx.context.getPlugin("first-party-apps");
+	if (!plugin) {
+		throw new BetterAuthError(
+			"challengeFirstPartyStepUpFromIssuance requires the first-party-apps plugin.",
+		);
+	}
+	const options = plugin.options as ResolvedFirstPartyAppsOptions;
+	if (!allowsAuthorizationCode(client) || client.disabled) return;
+	if (!(await options.isFirstPartyClient({ client, ctx }))) return;
+	const dpopJkt =
+		issuance.confirmation && "jkt" in issuance.confirmation
+			? issuance.confirmation.jkt
+			: null;
+	if (options.requireDpop && !dpopJkt) return;
+	const request = {
+		...input.request,
+		scope: input.request.scope ?? issuance.scopes.join(" "),
+		...(input.request.resource === undefined && issuance.resources
+			? { resource: issuance.resources }
+			: {}),
+	};
+	const issuedScopes = new Set(issuance.scopes);
+	if (request.scope.split(/\s+/).some((scope) => !issuedScopes.has(scope))) {
+		return;
+	}
+	const issuedResources = new Set(issuance.resources ?? []);
+	const requestedResources = toResourceList(request.resource);
+	if (
+		requestedResources?.some((resource) => !issuedResources.has(resource))
+	) {
+		return;
+	}
+	await createStepUpChallenge(ctx, options, {
+		client,
+		userId: user.id,
+		sessionId: issuance.sessionId ?? null,
+		dpopJkt,
+		request,
+		description: input.description,
+		ceiling: {
+			scope: issuance.scopes.join(" "),
+			...(issuance.resources?.length
+				? { resource: issuance.resources }
+				: {}),
+		},
+	});
+}
+
+async function createStepUpChallenge(
+	ctx: GenericEndpointContext,
+	options: ResolvedFirstPartyAppsOptions,
+	input: {
+		client: FirstPartyClient;
+		userId: string;
+		sessionId?: string | null;
+		dpopJkt: string | null;
+		request: FirstPartyAuthorizationRequest & { scope: string };
+		description?: string;
+		fields?: Record<string, unknown>;
+		ceiling?: GrantCeiling;
+	},
+): Promise<void> {
+	const live = input.sessionId
+		? await findLiveSession(ctx, input.sessionId)
+		: null;
+	const session = live?.session.userId === input.userId ? live.session : null;
+	// A sessionless row needs a holder the server can recognize: a confidential
+	// client or the grant's DPoP key.
+	if (
+		!session &&
+		input.dpopJkt === null &&
+		input.client.tokenEndpointAuthMethod === "none"
+	) {
+		return;
+	}
+
+	const ceiling: GrantCeiling = input.ceiling ?? {
+			scope: input.request.scope,
+		...(toResourceList(input.request.resource)
+			? { resource: toResourceList(input.request.resource) }
+			: {}),
+		...(input.request.claims !== undefined
+			? { claims: input.request.claims }
+			: {}),
+	};
+	const request: FirstPartyAuthorizationRequest = Object.fromEntries(
+		Object.entries(input.request).filter(([, value]) => value !== undefined),
+	);
+	const existing = await findStepUpRow(ctx, {
+		clientId: input.client.clientId,
+		userId: input.userId,
+		sessionId: session?.id ?? null,
+		dpopJkt: input.dpopJkt,
+	});
+	const rowFields = {
+		request: JSON.stringify(request),
+		ceiling: JSON.stringify(ceiling),
+		method: null,
+		methodState: null,
+	};
+	const handle = existing
+		? await rotateAuthSessionHandle(ctx, existing.id, rowFields)
+		: (
+				await createAuthSession(ctx, {
+					...rowFields,
+					clientId: input.client.clientId,
+					userId: input.userId,
+					sessionId: session?.id ?? null,
+					ownsSession: false,
+						dpopJkt: input.dpopJkt,
+					state: session ? "authenticated" : "pending",
+					amr: null,
+					expiresAt: rowExpiry(options, {
+						sessionExpiresAt: session?.expiresAt,
+							bound: input.dpopJkt !== null,
+					}),
+				})
+			).handle;
+
+	challengeError(
+		"FORBIDDEN",
+		"insufficient_authorization",
+		input.description ?? ERRORS.STEP_UP_REQUIRED.message,
+		{ ...input.fields, auth_session: handle },
+		responseHeaders(ctx),
+	);
+}
+
+function allowsAuthorizationCode(client: FirstPartyClient): boolean {
+	return client.grantTypes?.length
+		? client.grantTypes.includes("authorization_code")
+		: true;
+}
+
+/** C4: one row per client, user, session, and DPoP key. */
+async function findStepUpRow(
+	ctx: GenericEndpointContext,
+	key: {
+		clientId: string;
+		userId: string;
+		sessionId: string | null;
+		dpopJkt: string | null;
+	},
+): Promise<FirstPartyAuthSession | null> {
+	const rows = await ctx.context.adapter.findMany<FirstPartyAuthSession>({
+		model: AUTH_SESSION_MODEL,
+		where: key.sessionId
+			? [{ field: "sessionId", value: key.sessionId }]
+			: [{ field: "userId", value: key.userId }],
+	});
+	const now = new Date();
+	return (
+		rows.find(
+			(row) =>
+				row.clientId === key.clientId &&
+				row.userId === key.userId &&
+				(row.sessionId ?? null) === key.sessionId &&
+				(row.dpopJkt ?? null) === key.dpopJkt &&
+				row.ceiling &&
+				new Date(row.expiresAt) > now,
+		) ?? null
+	);
+}
+
+/**
+ * The headers this request accumulated, such as the next `DPoP-Nonce`. A
+ * before hook writes them to the dispatch context, which an error thrown
+ * from the hook does not carry by itself.
+ */
+function responseHeaders(ctx: GenericEndpointContext): Headers {
+	const headers = new Headers(NO_STORE_HEADERS);
+	const sources = [
+		(ctx.context as { responseHeaders?: Headers }).responseHeaders,
+		ctx.responseHeaders,
+	];
+	for (const source of sources) {
+		source?.forEach((value, name) => {
+			headers.set(name, value);
+		});
+	}
+	return headers;
+}
diff --git a/packages/first-party-apps/src/types.ts b/packages/first-party-apps/src/types.ts
new file mode 100644
index 0000000..37fddf9
--- /dev/null
+++ b/packages/first-party-apps/src/types.ts
@@ -0,0 +1,326 @@
+import type {
+	AuthContext,
+	Awaitable,
+	GenericEndpointContext,
+} from "@better-auth/core";
+import type { Session, User } from "@better-auth/core/db";
+import type {
+	OAuthBeforeTokenIssuanceInput,
+	SchemaClient,
+	Scope,
+} from "@better-auth/oauth-provider";
+import type { schema } from "./schema";
+
+export type FirstPartyClient = SchemaClient<Scope[]>;
+
+/**
+ * The authorization request a code is issued for, as the client sent it on the
+ * initial request or replaced it on a later one.
+ */
+export interface FirstPartyAuthorizationRequest {
+	scope?: string;
+	resource?: string | string[];
+	claims?: string;
+	acr_values?: string;
+	max_age?: number;
+	prompt?: string;
+	nonce?: string;
+	code_challenge?: string;
+	code_challenge_method?: string;
+	ui_locales?: string;
+}
+
+export interface FirstPartyMethodStartInput {
+	ctx: GenericEndpointContext;
+	client: FirstPartyClient;
+	/** The `login_hint` of an initial request. Absent when `user` is set. */
+	loginHint?: string;
+	/** The user to authenticate again, for step-up or an elapsed `max_age`. */
+	user?: User;
+	/**
+	 * Request parameters the plugin does not own, such as a method-specific
+	 * `chain_id`. On a restart after a failed response, these are the
+	 * parameters of the request that started the flow.
+	 */
+	params: Record<string, unknown>;
+	/**
+	 * Set when the plugin starts the method again after a failed response in
+	 * the same flow. `state` is the state of the challenge that failed.
+	 */
+	previous?: { state: unknown };
+}
+
+export type FirstPartyMethodStartResult =
+	| {
+			type: "challenge";
+			/**
+			 * The account the challenge is for, or null for an unknown or not yet
+			 * identified account. It also selects the failure-budget key: the
+			 * account when it is known, the hint otherwise.
+			 */
+			userId: string | null;
+			/** Fields added to the 403 response next to `challenge_type`. */
+			challenge?: Record<string, unknown>;
+			/** JSON-serializable state for `respond`. The plugin encrypts it at rest. */
+			state?: unknown;
+	  }
+	| { type: "redirect_to_web" };
+
+export interface FirstPartyMethodRespondInput {
+	ctx: GenericEndpointContext;
+	client: FirstPartyClient;
+	/** The `userId` that `start` returned. */
+	userId: string | null;
+	/** The `login_hint` the flow started with, when it started from one. */
+	loginHint?: string;
+	params: Record<string, unknown>;
+	state: unknown;
+}
+
+export type FirstPartyMethodRespondResult =
+	| { type: "challenge"; challenge?: Record<string, unknown>; state?: unknown }
+	| { type: "authenticated"; userId: string; amr?: readonly string[] }
+	/** The credential verified, but the account must finish in the browser, for example to verify its email. */
+	| { type: "redirect_to_web" }
+	| { type: "failed" };
+
+/**
+ * A credential check. `start` issues a challenge and `respond` checks the
+ * client's answer, possibly over several rounds.
+ */
+export interface FirstPartyMethod {
+	/** The `challenge_type` clients see, and part of the failure-budget key. */
+	id: string;
+	/** RFC 8176 values this method proves, such as `["pwd"]`. */
+	amr: readonly string[];
+	/**
+	 * Request parameters that carry a response to this method's challenge.
+	 * They must not overlap the parameters the plugin owns or another
+	 * method's.
+	 */
+	responseParameters: readonly string[];
+	/** Called from the plugin's `init`, to fail fast on missing configuration. */
+	init?: (ctx: AuthContext) => void;
+	start: (
+		input: FirstPartyMethodStartInput,
+	) => Awaitable<FirstPartyMethodStartResult | null>;
+	/**
+	 * Runs after the plugin verified the request's DPoP proof and client. For
+	 * a client that authenticates with a single-use assertion, the provider
+	 * checks the assertion only when it issues the code, so keep `respond`
+	 * free of effects the user would notice.
+	 */
+	respond: (
+		input: FirstPartyMethodRespondInput,
+	) => Awaitable<FirstPartyMethodRespondResult>;
+}
+
+export type FirstPartyAuthorizationDecision =
+	| undefined
+	| void
+	| {
+			type: "insufficient_authorization";
+			description?: string;
+			fields?: Record<string, unknown>;
+	  }
+	| { type: "reauthenticate"; description?: string }
+	| { type: "redirect_to_web"; description?: string };
+
+export interface FirstPartyAuthorizationPolicyInput {
+	ctx: GenericEndpointContext;
+	client: FirstPartyClient;
+	user: User;
+	request: FirstPartyAuthorizationRequest;
+	authentication: {
+		authTime: Date;
+		amr: readonly string[];
+		/** True when the user proved a credential in this request. */
+		fresh: boolean;
+	};
+}
+
+export interface FirstPartySessionFieldsInput {
+	ctx: GenericEndpointContext;
+	client: FirstPartyClient;
+	user: User;
+	method: string;
+	amr: readonly string[];
+}
+
+export interface FirstPartyAppsOptions {
+	/**
+	 * Decides whether a client may use the endpoint (draft §5, §9.1). Called on
+	 * every request. Return `false` for browser-based clients unless there is a
+	 * reason to allow them (§9.8).
+	 */
+	isFirstPartyClient: (input: {
+		client: FirstPartyClient;
+		ctx: GenericEndpointContext;
+	}) => Awaitable<boolean>;
+	/** Credential methods, in order of preference. At least one. */
+	methods: FirstPartyMethod[];
+	/**
+	 * Runs before every code the plugin issues, after the request's DPoP proof
+	 * is verified. It must not change state.
+	 */
+	authorizationPolicy?: (
+		input: FirstPartyAuthorizationPolicyInput,
+	) => Awaitable<FirstPartyAuthorizationDecision>;
+	/**
+	 * Require a DPoP proof on the initial request, which binds the
+	 * `auth_session` and the code to the client's key (draft §5.3.1, §9.6).
+	 * A client registered with `dpop_bound_access_tokens` always needs one.
+	 *
+	 * @default false
+	 */
+	requireDpop?: boolean;
+	session?: {
+		/**
+		 * Lifetime in seconds of a session the plugin creates. It bounds the
+		 * tokens issued from it.
+		 *
+		 * @default the app's `session.expiresIn`
+		 */
+		expiresIn?: number;
+		/**
+		 * Extra fields for a session the plugin creates, before the code is
+		 * issued. When issuance then fails, the plugin deletes the session
+		 * through the internal adapter, so clean up anything this callback
+		 * created in a session delete hook.
+		 */
+		fields?: (
+			input: FirstPartySessionFieldsInput,
+		) => Awaitable<Record<string, unknown>>;
+	};
+	authSession?: {
+		/**
+		 * Lifetime in seconds of an `auth_session` whose user has not
+		 * authenticated yet, and the most an `auth_session` without a DPoP
+		 * binding lives.
+		 *
+		 * @default 600
+		 */
+		expiresIn?: number;
+		/**
+		 * Failed responses one `auth_session` allows before the plugin answers
+		 * `redirect_to_web` and ends it.
+		 *
+		 * @default 3
+		 */
+		maxFailures?: number;
+		/**
+		 * Requests one pending `auth_session` allows (draft §9.3).
+		 *
+		 * @default 20
+		 */
+		maxRequests?: number;
+	};
+	/**
+	 * Failed responses allowed per account and method within `window`
+	 * seconds. A locked account answers every response as a failure.
+	 *
+	 * @default { maxFailures: 10, window: 900 }
+	 */
+	failureBudget?: { maxFailures?: number; window?: number } | false;
+	/**
+	 * Per-IP limit on the endpoint.
+	 *
+	 * @default { window: 60, max: 10 }
+	 */
+	rateLimit?: { window?: number; max?: number };
+	/** Model and field name overrides. */
+	schema?: FirstPartyAppsSchemaOptions;
+}
+
+export type FirstPartyAppsSchemaOptions = {
+	[Model in keyof typeof schema]?: {
+		modelName?: string;
+		fields?: {
+			[Field in keyof (typeof schema)[Model]["fields"]]?: string;
+		};
+	};
+};
+
+export interface ResolvedFirstPartyAppsOptions {
+	isFirstPartyClient: FirstPartyAppsOptions["isFirstPartyClient"];
+	methods: FirstPartyMethod[];
+	authorizationPolicy?: FirstPartyAppsOptions["authorizationPolicy"];
+	requireDpop: boolean;
+	session: {
+		expiresIn?: number;
+		fields?: NonNullable<FirstPartyAppsOptions["session"]>["fields"];
+	};
+	authSession: { expiresIn: number; maxFailures: number; maxRequests: number };
+	failureBudget: { maxFailures: number; window: number } | false;
+	rateLimit: { window: number; max: number };
+}
+
+/**
+ * Input of {@link challengeFirstPartyStepUp}. The caller must already have
+ * verified the grant credential (the refresh token or CIBA request), that it
+ * belongs to `clientId`, and that it has not expired. The helper trusts these
+ * facts and verifies only the request itself.
+ */
+export interface FirstPartyStepUpInput {
+	/** The client the grant was issued to. The token request must authenticate as this client. */
+	clientId: string;
+	userId: string;
+	/** The grant's session, or null when it has none. A follow-up reuses a live one. */
+	sessionId: string | null;
+	/** The key the grant is bound to (`cnf.jkt`), or null for a grant without DPoP binding. */
+	dpopJkt: string | null;
+	/**
+	 * The authorization the grant holds. A follow-up can narrow it but never
+	 * widen it. Authorization codes cannot carry RFC 9396
+	 * `authorization_details`, so do not offer a step-up for a grant whose
+	 * tokens depend on them.
+	 */
+	request: {
+		scope: string;
+		resource?: string | string[];
+		claims?: string;
+		acr_values?: string;
+		max_age?: number;
+	};
+	description?: string;
+	fields?: Record<string, unknown>;
+}
+
+/** A step-up raised after the OAuth provider authenticated a grant issuance. */
+export interface FirstPartyStepUpFromIssuanceInput {
+	/** The live input received by `beforeTokenIssuance`. */
+	issuance: OAuthBeforeTokenIssuanceInput;
+	/** The authorization request the next first-party code must satisfy. */
+	request: FirstPartyAuthorizationRequest;
+	description?: string;
+}
+
+export interface FirstPartyAuthSession {
+	id: string;
+	authSession: string;
+	clientId: string;
+	userId?: string | null;
+	sessionId?: string | null;
+	ownsSession: boolean;
+	dpopJkt?: string | null;
+	state: "pending" | "authenticated";
+	method?: string | null;
+	methodState?: string | null;
+	request: string;
+	ceiling?: string | null;
+	amr?: string[] | null;
+	failures: number;
+	attempts: number;
+	expiresAt: Date;
+	createdAt: Date;
+	updatedAt: Date;
+}
+
+export interface FirstPartyFailureBudget {
+	id: string;
+	key: string;
+	failures: number;
+	resetAt: Date;
+}
+
+export type { Session, User };
diff --git a/packages/first-party-apps/test/auth-session.test.ts b/packages/first-party-apps/test/auth-session.test.ts
