@@ -0,0 +1,226 @@
+import { twoFactor } from "better-auth/plugins";
+import { describe, expect, it } from "vitest";
+import type { FirstPartyMethod } from "../src";
+import { passwordMethod } from "../src";
+import { getBudgetKey } from "../src/failure-budget";
+import type { FpaServer } from "./fpa-server";
+import { createFpaServer, TEST_EMAIL, TEST_PASSWORD } from "./fpa-server";
+
+async function respondSequence(
+	server: FpaServer,
+	clientId: string,
+	passwords: string[],
+	loginHint = TEST_EMAIL,
+) {
+	const { res } = await server.startPassword(clientId, {
+		extra: { login_hint: loginHint },
+	});
+	const outcomes: Array<{ status: number; error?: string }> = [];
+	for (const password of passwords) {
+		const reply = await server.challenge({
+			auth_session: res.body.auth_session,
+			password,
+		});
+		outcomes.push({ status: reply.status, error: reply.body.error });
+	}
+	return outcomes;
+}
+
+async function budgetRows(server: FpaServer) {
+	const ctx = await server.auth.$context;
+	return ctx.adapter.findMany({ model: "firstPartyFailureBudget" }) as Promise<
+		Array<{ key: string; failures: number; resetAt: Date }>
+	>;
+}
+
+describe("first-party apps - failure budget (C1)", async () => {
+	const server = await createFpaServer({
+		plugin: { failureBudget: { maxFailures: 4, window: 900 } },
+	});
+	const client = await server.createClient();
+	const wrong = "wrong-password";
+
+	it("locks an account after failures across auth_sessions, silently", async () => {
+		expect(
+			await respondSequence(server, client.client_id, [wrong, wrong]),
+		).toEqual([
+			{ status: 400, error: "authentication_failed" },
+			{ status: 400, error: "authentication_failed" },
+		]);
+		// Another spelling of the same address counts against the same account.
+		await respondSequence(
+			server,
+			client.client_id,
+			[wrong, wrong],
+			"TEST@test.com",
+		);
+		const locked = await respondSequence(server, client.client_id, [
+			TEST_PASSWORD,
+		]);
+		expect(locked).toEqual([{ status: 400, error: "authentication_failed" }]);
+	});
+
+	it("answers a locked account's correct and wrong credentials the same, ending with redirect_to_web", async () => {
+		const correctFirst = await respondSequence(server, client.client_id, [
+			TEST_PASSWORD,
+			wrong,
+			wrong,
+		]);
+		const allWrong = await respondSequence(server, client.client_id, [
+			wrong,
+			wrong,
+			wrong,
+		]);
+		const allCorrect = await respondSequence(server, client.client_id, [
+			TEST_PASSWORD,
+			TEST_PASSWORD,
+			TEST_PASSWORD,
+		]);
+		const expected = [
+			{ status: 400, error: "authentication_failed" },
+			{ status: 400, error: "authentication_failed" },
+			{ status: 403, error: "redirect_to_web" },
+		];
+		expect(correctFirst).toEqual(expected);
+		expect(allWrong).toEqual(expected);
+		expect(allCorrect).toEqual(expected);
+	});
+
+	it("does not count a locked account's responses against its budget", async () => {
+		const rows = await budgetRows(server);
+		expect(rows.map((row) => row.failures)).toContain(4);
+		expect(rows.every((row) => row.failures <= 4)).toBe(true);
+	});
+
+	it("unlocks after the window", async () => {
+		const ctx = await server.auth.$context;
+		for (const row of await budgetRows(server)) {
+			await ctx.adapter.update({
+				model: "firstPartyFailureBudget",
+				where: [{ field: "key", value: row.key }],
+				update: { resetAt: new Date(Date.now() - 1000) },
+			});
+		}
+		const { final } = await server.signIn(client.client_id);
+		expect(final.status).toBe(200);
+	});
+
+	it("locks an unknown email after the same number of failures", async () => {
+		const hint = "ghost@example.com";
+		await respondSequence(server, client.client_id, [wrong, wrong], hint);
+		await respondSequence(
+			server,
+			client.client_id,
+			[wrong, wrong, wrong],
+			hint,
+		);
+		const ctx = await server.auth.$context;
+		const key = await getBudgetKey({ context: ctx } as never, "password", {
+			loginHint: hint,
+		});
+		const ghost = (await budgetRows(server)).filter((row) => row.key === key);
+		expect(ghost.map((row) => row.failures)).toEqual([4]);
+	});
+
+	it("stores no email or user id in the budget table", async () => {
+		const ctx = await server.auth.$context;
+		const user = await ctx.internalAdapter.findUserByEmail(TEST_EMAIL);
+		const serialized = JSON.stringify(await budgetRows(server));
+		expect(serialized).not.toContain(TEST_EMAIL);
+		expect(serialized).not.toContain("ghost@example.com");
+		expect(serialized).not.toContain(user!.user.id);
+	});
+});
+
+describe("first-party apps - failure budget under concurrent responses", async () => {
+	// The test instance hashes passwords synchronously, which hides races that
+	// production's scrypt opens, so `respond` waits before checking.
+	const password = passwordMethod();
+	const slowPassword: FirstPartyMethod = {
+		...password,
+		async respond(input) {
+			await new Promise((resolve) => setTimeout(resolve, 30));
+			return password.respond(input);
+		},
+	};
+	const server = await createFpaServer({
+		plugin: { failureBudget: { maxFailures: 4, window: 900 } },
+		methods: [slowPassword],
+	});
+	const client = await server.createClient();
+
+	it("gives back the reserved failure when the credential is right", async () => {
+		await respondSequence(server, client.client_id, ["wrong-password"]);
+		const { final } = await server.signIn(client.client_id);
+		expect(final.status).toBe(200);
+		expect((await budgetRows(server)).map((row) => row.failures)).toEqual([1]);
+	});
+
+	it("checks no more credentials than the budget allows", async () => {
+		const handles: string[] = [];
+		for (let i = 0; i < 20; i++) {
+			const { res } = await server.startPassword(client.client_id);
+			handles.push(res.body.auth_session);
+		}
+		const replies = await Promise.all(
+			handles.map((handle) =>
+				server.challenge({ auth_session: handle, password: "wrong-password" }),
+			),
+		);
+		expect(
+			replies.every((reply) => reply.body.error === "authentication_failed"),
+		).toBe(true);
+		expect((await budgetRows(server)).map((row) => row.failures)).toEqual([4]);
+		const { final } = await server.signIn(client.client_id);
+		expect(final.body.error).toBe("authentication_failed");
+	});
+});
+
+describe("first-party apps - two-factor", async () => {
+	const server = await createFpaServer({ extraPlugins: [twoFactor()] });
+	const client = await server.createClient();
+	const enrolled = "enrolled@example.com";
+	await server.auth.api.signUpEmail!({
+		body: { email: enrolled, password: TEST_PASSWORD, name: "Enrolled" },
+	});
+	const ctx = await server.auth.$context;
+	await ctx.internalAdapter.updateUserByEmail(enrolled, {
+		twoFactorEnabled: true,
+	});
+
+	it("sends an enrolled user to the browser after a correct password, without a session or code", async () => {
+		const sessionsBefore = (await server.sessionRows()).length;
+		const { res } = await server.startPassword(client.client_id, {
+			extra: { login_hint: enrolled },
+		});
+		const final = await server.challenge({
+			auth_session: res.body.auth_session,
+			password: TEST_PASSWORD,
+		});
+		expect(final.status).toBe(403);
+		expect(final.body.error).toBe("redirect_to_web");
+		expect(final.body.authorization_code).toBeUndefined();
+		expect((await server.sessionRows()).length).toBe(sessionsBefore);
+	});
+
+	it("answers the initial and wrong-password requests the same for enrolled and other users", async () => {
+		const shape = async (loginHint: string) => {
+			const { res } = await server.startPassword(client.client_id, {
+				extra: { login_hint: loginHint },
+			});
+			const failed = await server.challenge({
+				auth_session: res.body.auth_session,
+				password: "wrong-password",
+			});
+			return {
+				initial: [res.status, Object.keys(res.body).sort()],
+				failed: [
+					failed.status,
+					failed.body.error,
+					Object.keys(failed.body).sort(),
+				],
+			};
+		};
+		expect(await shape(enrolled)).toEqual(await shape(TEST_EMAIL));
+	});
+});
diff --git a/packages/first-party-apps/test/fpa-server.ts b/packages/first-party-apps/test/fpa-server.ts
new file mode 100644
index 0000000..1596df4
--- /dev/null
+++ b/packages/first-party-apps/test/fpa-server.ts
@@ -0,0 +1,378 @@
+import type { BetterAuthOptions } from "@better-auth/core";
+import type { OAuthOptions, Scope } from "@better-auth/oauth-provider";
+import { oauthProvider } from "@better-auth/oauth-provider";
+import type { BetterAuthPlugin } from "better-auth";
+import { jwt } from "better-auth/plugins/jwt";
+import { getTestInstance } from "better-auth/test";
+import type { JWK } from "jose";
+import {
+	base64url,
+	calculateJwkThumbprint,
+	decodeJwt,
+	exportJWK,
+	generateKeyPair,
+	SignJWT,
+} from "jose";
+import type {
+	FirstPartyAppsOptions,
+	FirstPartyAuthSession,
+	FirstPartyMethod,
+} from "../src";
+import { firstPartyApps, passwordMethod } from "../src";
+import { findAuthSession } from "../src/auth-session";
+
+export const BASE_URL = "http://localhost:3000";
+export const AUTH_BASE_URL = `${BASE_URL}/api/auth`;
+export const CHALLENGE_URL = `${AUTH_BASE_URL}/oauth2/authorize-challenge`;
+export const TOKEN_URL = `${AUTH_BASE_URL}/oauth2/token`;
+export const TEST_EMAIL = "test@test.com";
+export const TEST_PASSWORD = "test123456";
+
+type KeyPair = Awaited<ReturnType<typeof generateKeyPair>>;
+export type DpopKey = { keyPair: KeyPair; jwk: JWK; jkt: string };
+
+export async function createDpopKey(): Promise<DpopKey> {
+	const keyPair = await generateKeyPair("ES256");
+	const jwk = await exportJWK(keyPair.publicKey);
+	return { keyPair, jwk, jkt: await calculateJwkThumbprint(jwk) };
+}
+
+export async function createDpopProof(
+	key: DpopKey,
+	input: { url: string; nonce?: string; jwk?: JWK; signWith?: DpopKey },
+) {
+	return new SignJWT({
+		htm: "POST",
+		htu: input.url,
+		jti: crypto.randomUUID(),
+		...(input.nonce ? { nonce: input.nonce } : {}),
+	})
+		.setProtectedHeader({
+			alg: "ES256",
+			typ: "dpop+jwt",
+			jwk: input.jwk ?? key.jwk,
+		})
+		.setIssuedAt()
+		.sign((input.signWith ?? key).keyPair.privateKey);
+}
+
+export async function createPkce() {
+	const verifier = `${crypto.randomUUID()}${crypto.randomUUID()}`;
+	const digest = await crypto.subtle.digest(
+		"SHA-256",
+		new TextEncoder().encode(verifier),
+	);
+	return {
+		verifier,
+		challenge: base64url.encode(new Uint8Array(digest)),
+	};
+}
+
+/**
+ * A two-round test method for hints of the form `otp:<email>`. The first
+ * round answers `otp_code=one` with a second challenge; the second answers
+ * `otp_code=two` as authenticated. Anything else fails.
+ */
+export function createRecordingMethod(id = "otp") {
+	const calls = { start: 0, respond: 0, starts: [] as unknown[] };
+	const behavior = { failStart: false };
+	const method: FirstPartyMethod = {
+		id,
+		amr: ["otp"],
+		responseParameters: [`${id}_code`],
+		async start(input) {
+			calls.start += 1;
+			calls.starts.push({
+				loginHint: input.loginHint,
+				userId: input.user?.id,
+				params: input.params,
+				previous: input.previous,
+			});
+			if (behavior.failStart) return { type: "redirect_to_web" };
+			let userId: string | null = null;
+			if (input.user) userId = input.user.id;
+			else if (input.loginHint?.startsWith(`${id}:`)) {
+				const found = await input.ctx.context.internalAdapter.findUserByEmail(
+					input.loginHint.slice(id.length + 1),
+				);
+				userId = found?.user.id ?? null;
+			} else return null;
+			return {
+				type: "challenge",
+				userId,
+				challenge: { round: 1, error: "overridden", auth_session: "x" },
+				state: { round: 1 },
+			};
+		},
+		async respond({ params, state, userId }) {
+			calls.respond += 1;
+			const round = (state as { round: number }).round;
+			const code = params[`${id}_code`];
+			if (round === 1 && code === "one") {
+				return {
+					type: "challenge",
+					challenge: { round: 2 },
+					state: { round: 2 },
+				};
+			}
+			if (round === 2 && code === "two" && userId) {
+				return { type: "authenticated", userId };
+			}
+			if (code === "web") return { type: "redirect_to_web" };
+			return { type: "failed" };
+		},
+	};
+	return { method, calls, behavior };
+}
+
+export async function createFpaServer(input?: {
+	plugin?: Partial<FirstPartyAppsOptions>;
+	methods?: FirstPartyMethod[];
+	oauth?: Partial<OAuthOptions<Scope[]>>;
+	auth?: Partial<BetterAuthOptions>;
+	extraPlugins?: BetterAuthPlugin[];
+	/** Send the latest DPoP-Nonce with every proof, retrying once when asked. */
+	autoNonce?: boolean;
+}) {
+	const firstParty = new Set<string>();
+	let lastNonce: string | undefined;
+	const recording = createRecordingMethod();
+	let fetcher: typeof fetch | undefined;
+	const options = {
+		baseURL: BASE_URL,
+		...input?.auth,
+		plugins: [
+			jwt({ jwt: { issuer: BASE_URL } }),
+			oauthProvider({
+				loginPage: "/login",
+				consentPage: "/consent",
+				silenceWarnings: { oauthAuthServerConfig: true, openidConfig: true },
+				...input?.oauth,
+			}),
+			firstPartyApps({
+				isFirstPartyClient: ({ client }) => firstParty.has(client.clientId),
+				methods: input?.methods ?? [passwordMethod(), recording.method],
+				...input?.plugin,
+			}),
+			...(input?.extraPlugins ?? []),
+		],
+	} satisfies BetterAuthOptions;
+	const instance = await getTestInstance(options);
+	fetcher = instance.customFetchImpl as typeof fetch;
+	const context = await instance.auth.$context;
+	await context.internalAdapter.updateUserByEmail(TEST_EMAIL, {
+		emailVerified: true,
+	});
+	const { headers: adminHeaders } = await instance.signInWithTestUser();
+	const auth = instance.auth as unknown as {
+		api: Record<string, (input?: any) => Promise<any>>;
+		$context: Promise<any>;
+	};
+
+	async function createClient(
+		body: Record<string, unknown> = {},
+		config: { firstParty?: boolean } = {},
+	): Promise<{ client_id: string; client_secret?: string }> {
+		const client = await auth.api.adminCreateOAuthClient!({
+			headers: adminHeaders,
+			body: {
+				redirect_uris: ["https://app.example/callback"],
+				token_endpoint_auth_method: "none",
+				grant_types: ["authorization_code", "refresh_token"],
+				skip_consent: true,
+				...body,
+			},
+		});
+		if (config.firstParty !== false) firstParty.add(client.client_id);
+		return client;
+	}
+
+	async function post(
+		url: string,
+		params: Record<string, string | string[]>,
+		config: {
+			dpop?: DpopKey;
+			proof?: string;
+			nonce?: string;
+			json?: boolean;
+			headers?: Record<string, string>;
+		} = {},
+	) {
+		const headers: Record<string, string> = { ...config.headers };
+		let body: string;
+		if (config.json) {
+			headers["content-type"] = "application/json";
+			body = JSON.stringify(params);
+		} else {
+			headers["content-type"] = "application/x-www-form-urlencoded";
+			const form = new URLSearchParams();
+			for (const [name, value] of Object.entries(params)) {
+				for (const item of Array.isArray(value) ? value : [value]) {
+					form.append(name, item);
+				}
+			}
+			body = form.toString();
+		}
+		const autoNonce = !!input?.autoNonce && !config.nonce && !config.proof;
+		const send = async (nonce: string | undefined) => {
+			if (config.proof) headers.dpop = config.proof;
+			else if (config.dpop) {
+				headers.dpop = await createDpopProof(config.dpop, { url, nonce });
+			}
+			const response = await fetcher!(url, { method: "POST", headers, body });
+			const next = response.headers.get("dpop-nonce");
+			if (next) lastNonce = next;
+			return response;
+		};
+		let res = await send(autoNonce ? lastNonce : config.nonce);
+		if (autoNonce && config.dpop && res.status === 400) {
+			const retry = res.clone();
+			const error = (
+				(await retry.json().catch(() => ({}))) as { error?: string }
+			).error;
+			if (error === "use_dpop_nonce") res = await send(lastNonce);
+		}
+		const text = await res.text();
+		let json: Record<string, any> = {};
+		try {
+			json = JSON.parse(text);
+		} catch {}
+		return { status: res.status, headers: res.headers, body: json };
+	}
+
+	const challenge = (
+		params: Record<string, string | string[]>,
+		config?: Parameters<typeof post>[2],
+	) => post(CHALLENGE_URL, params, config);
+
+	async function startPassword(
+		clientId: string,
+		config: { dpop?: DpopKey; extra?: Record<string, string> } = {},
+	) {
+		const pkce = await createPkce();
+		const res = await challenge(
+			{
+				client_id: clientId,
+				response_type: "code",
+				scope: "openid offline_access",
+				login_hint: TEST_EMAIL,
+				code_challenge: pkce.challenge,
+				code_challenge_method: "S256",
+				...config.extra,
+			},
+			{ dpop: config.dpop },
+		);
+		return { res, pkce };
+	}
+
+	/** Hint, password, code. Returns the code and the PKCE verifier. */
+	async function signIn(
+		clientId: string,
+		config: {
+			dpop?: DpopKey;
+			extra?: Record<string, string>;
+			password?: string;
+		} = {},
+	) {
+		const { res, pkce } = await startPassword(clientId, config);
+		if (res.status !== 403) {
+			throw new Error(`initial request failed: ${JSON.stringify(res.body)}`);
+		}
+		const final = await challenge(
+			{
+				auth_session: res.body.auth_session,
+				password: config.password ?? TEST_PASSWORD,
+			},
+			{ dpop: config.dpop },
+		);
+		return { final, pkce, handle: res.body.auth_session as string };
+	}
+
+	async function redeem(
+		clientId: string,
+		code: string,
+		verifier: string,
+		config: { dpop?: DpopKey; extra?: Record<string, string> } = {},
+	) {
+		return post(
+			TOKEN_URL,
+			{
+				grant_type: "authorization_code",
+				client_id: clientId,
+				code,
+				code_verifier: verifier,
+				...config.extra,
+			},
+			{ dpop: config.dpop },
+		);
+	}
+
+	async function authSessionRows(): Promise<FirstPartyAuthSession[]> {
+		const ctx = await auth.$context;
+		return ctx.adapter.findMany({ model: "firstPartyAuthSession" });
+	}
+
+	async function findRow(handle: string) {
+		const ctx = await auth.$context;
+		return findAuthSession({ context: ctx } as never, handle);
+	}
+
+	async function updateRow(id: string, update: Record<string, unknown>) {
+		const ctx = await auth.$context;
+		await ctx.adapter.update({
+			model: "firstPartyAuthSession",
+			where: [{ field: "id", value: id }],
+			update,
+		});
+	}
+
+	/** Starts the recording method's flow for the test user. */
+	async function startOtp(
+		clientId: string,
+		config: { dpop?: DpopKey; extra?: Record<string, string> } = {},
+	) {
+		const pkce = await createPkce();
+		const res = await challenge(
+			{
+				client_id: clientId,
+				response_type: "code",
+				scope: "openid",
+				login_hint: `otp:${TEST_EMAIL}`,
+				code_challenge: pkce.challenge,
+				code_challenge_method: "S256",
+				...config.extra,
+			},
+			{ dpop: config.dpop },
+		);
+		return { res, pkce, handle: res.body.auth_session as string };
+	}
+
+	async function sessionRows(): Promise<
+		Array<{ id: string; token: string; userId: string; createdAt: Date }>
+	> {
+		const ctx = await auth.$context;
+		return ctx.adapter.findMany({ model: "session" });
+	}
+
+	return {
+		auth,
+		firstParty,
+		recording,
+		adminHeaders,
+		customFetchImpl: fetcher,
+		createClient,
+		post,
+		challenge,
+		startPassword,
+		signIn,
+		redeem,
+		authSessionRows,
+		sessionRows,
+		findRow,
+		updateRow,
+		startOtp,
+		decodeJwt,
+	};
+}
+
+export type FpaServer = Awaited<ReturnType<typeof createFpaServer>>;
