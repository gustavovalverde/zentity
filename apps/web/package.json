{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "mkdir -p dist/plugins/two-factor && chmod -R 755 dist 2>/dev/null || true",
    "setup": "tsx scripts/setup.ts",
    "setup:coep-assets": "pnpm exec tsx scripts/setup-coep-assets.ts",
    "dev": "pnpm run setup:coep-assets && NODE_OPTIONS='--max-old-space-size=8192' next dev",
    "build": "pnpm run setup:coep-assets && next build",
    "start": "next start",
    "clean": "rm -rf .next test-results playwright-report coverage",
    "lint": "biome check --write --no-errors-on-unmatched",
    "lint:check": "biome check --no-errors-on-unmatched",
    "lint:fix": "biome check --write --no-errors-on-unmatched",
    "lint:format": "biome format . --write",
    "lint:md": "markdownlint \"**/*.md\" --config ../../.markdownlint.json --ignore \"node_modules/**\" --ignore \"playwright-report/**\" --ignore \"test-results/**\" --ignore \".next/**\" --fix",
    "lint:md:check": "markdownlint \"**/*.md\" --config ../../.markdownlint.json --ignore \"node_modules/**\" --ignore \"playwright-report/**\" --ignore \"test-results/**\" --ignore \".next/**\"",
    "lint:types": "oxlint --type-aware src/",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "check-all": "run-p --aggregate-output type-check lint:check lint:md:check lint:types knip circuits:check-versions build",
    "fix-all": "pnpm run type-check && pnpm run lint:fix && pnpm run lint:md && pnpm run knip:fix",
    "knip": "knip --strict --treat-config-hints-as-errors",
    "knip:production": "knip --strict --production --treat-config-hints-as-errors",
    "knip:fix": "knip --fix --strict --allow-remove-files",
    "format": "biome format --write .",
    "probe:mcp-http": "node --env-file=.env --import tsx scripts/probe-mcp-http.ts",
    "smoke:demo-rp-validity": "pnpm exec tsx scripts/demo-rp-validity-smoke.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs run --config vitest.unit.config.mts",
    "test:integration": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs run --config vitest.config.mts",
    "test:watch": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs --config vitest.unit.config.mts",
    "test:coverage": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs run --coverage --config vitest.unit.config.mts",
    "test:e2e": "pnpm exec playwright test --config playwright.config.mts",
    "test:e2e:ui": "pnpm exec playwright test --config playwright.config.mts --ui",
    "db:push": "drizzle-kit push",
    "db:push:dev": "TURSO_DATABASE_URL=file:./.data/dev.db drizzle-kit push",
    "circuits:compile": "cd noir-circuits && for d in */; do (cd \"$d\" && nargo compile && mkdir -p artifacts && cp -f target/*.json artifacts/); done",
    "circuits:test": "cd noir-circuits && for d in */; do (cd \"$d\" && nargo test); done",
    "circuits:profile": "pnpm exec tsx scripts/noir-profile.ts",
    "circuits:profile:opcodes": "pnpm exec tsx scripts/noir-profile.ts opcodes",
    "circuits:profile:gates": "pnpm exec tsx scripts/noir-profile.ts gates",
    "circuits:profile:execution": "pnpm exec tsx scripts/noir-profile.ts execution-opcodes",
    "circuits:check-versions": "pnpm exec tsx scripts/check-noir-versions.ts",
    "test:ciba-cli": "pnpm exec tsx scripts/ciba-cli-test.ts"
  },
