{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "vitest.global-setup.ts",
    "vitest.setup.mts",
    "vitest.integration.setup.mts",
    "e2e/run-global-setup.ts",
    "e2e/automation/*.ts",
    "e2e/wallet-setup/*.ts",
    "scripts/*.ts",
    "src/lib/auth/oidc/mcp-client.ts!"
  ],
  "project": [
    "**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
    "!e2e/**!",
    "!scripts/**!"
  ],
  "ignoreIssues": {
    "src/components/ui/**": ["exports", "types"],
    "src/app/dashboard/(web3)/defi-demo/_components/tx-history.tsx": [
      "exports"
    ],
    "src/components/vault-unlock.tsx": ["exports", "types"],
    "src/lib/agents/claims.ts": ["exports"],
    "src/lib/auth/oidc/disclosure/delivery.ts": ["exports"],
    "src/lib/auth/oidc/jwt-signer.ts": ["exports"],
    "src/lib/auth/oidc/pairwise.ts": ["exports"],
    "src/lib/auth/oidc/step-up.ts": ["exports"],
    "src/lib/auth/passkey/client.ts": ["exports", "types"],
    "src/lib/auth/recovery-factors.ts": ["exports", "types"],
    "src/lib/blockchain/attestation/providers.ts": ["exports", "types"],
    "src/lib/blockchain/confidential/client-networks.ts": ["exports"],
    "src/lib/db/queries/attestation.ts": ["exports"],
    "src/lib/http/rate-limit.ts": ["exports"],
    "src/lib/identity/liveness/human/server.ts": ["exports"],
    "src/lib/identity/world-id.ts": ["types"],
    "src/lib/observability/client-metrics.ts": ["types"],
    "src/lib/privacy/zk/country.ts": ["exports"],
    "src/lib/privacy/zk/version-check.ts": ["exports"],
    "src/lib/trpc/routers/zk.ts": ["exports"]
  },
  "ignore": [
    "public/coi-serviceworker.js",
    "public/push-sw.js",
    "src/test-utils/**",
    "src/lib/turbopack-stubs/**"
  ],
  "ignoreDependencies": [
    "@commitlint/cli",
    "@commitlint/config-conventional",
    "@noir-lang/acvm_js",
    "@noir-lang/noirc_abi",
    "@synthetixio/synpress-cache",
    "@zentity/sdk",
    "buffer",
    "node-tfhe",
    "pino-pretty",
    "tailwindcss",
    "tfhe",
    "tw-animate-css"
  ],
  "ignoreBinaries": ["nargo", "tsx"],
  "playwright": {
    "config": ["playwright.config.mts"]
  },
  "vitest": {
    "config": ["vitest.config.mts", "vitest.unit.config.mts"]
  }
}
