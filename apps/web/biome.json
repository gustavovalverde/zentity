{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next",
    "ultracite/biome/vitest",
    "ultracite/biome/type-aware"
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              {
                "type": true
              },
              ":BLANK_LINE:",
              ":NODE:",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              "@/**",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        },
        "useSortedPackageJson": "off",
        "useSortedKeys": "off"
      }
    }
  },
  "linter": {
    "domains": {
      "next": "recommended"
    },
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noVoid": "error",
        "noUselessUndefined": "off",
        "useOptionalChain": "off",
        "noUselessReturn": "off",
        "useMathMinMax": "off",
        "noDivRegex": "off"
      },
      "correctness": {
        "useImportExtensions": "off",
        "noUnresolvedImports": "off",
        "useJsonImportAttributes": "error",
        "noUnsafeOptionalChaining": "off"
      },
      "suspicious": {
        "noImportCycles": "error",
        "noUnnecessaryConditions": "off",
        "useArraySortCompare": "off",
        "noConditionalExpect": "off",
        "noJsxLeakedDollar": "off",
        "noNestedPromises": "off",
        "noLeakedRender": "off",
        "noEqualsToNull": "off",
        "noLoopFunc": "off",
        "useExpect": "off",
        "noShadow": "off"
      },
      "style": {
        "useConsistentMethodSignatures": "off",
        "useConsistentArrowReturn": "off",
        "useThisInClassMethods": "off",
        "useNamedCaptureGroup": "off",
        "noIncrementDecrement": "off",
        "useTestHooksInOrder": "off",
        "useConsistentTestIt": "off",
        "useDestructuring": "off",
        "useUnicodeRegex": "off",
        "useImportsFirst": "off",
        "useErrorCause": "off",
        "noSubstr": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": "off"
      },
      "performance": {
        "noJsxPropsBind": "off",
        "noAwaitInLoops": "off"
      },
      "a11y": {
        "noLabelWithoutControl": "off",
        "noAmbiguousAnchorText": "off"
      }
    }
  },
  "files": {
    "includes": [
      "src/**",
      "e2e/**",
      "scripts/**",
      "*.ts",
      "*.mts",
      "*.js",
      "*.cjs",
      "!!node_modules",
      "!!public",
      "!!noir-circuits",
      "!!.next",
      "!!.cache-synpress",
      "!!.synpress-wallet-setup-dist",
      "!!.data",
      "!!playwright-report",
      "!!test-results",
      "!!src/app/globals.css"
    ]
  },
  "overrides": [
    {
      "includes": ["e2e/**/*.ts", "e2e/**/*.spec.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noSkippedTests": "off"
          },
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/**/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useFocusableInteractive": "off",
            "useSemanticElements": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "style": {
            "useImportType": "off"
          },
          "suspicious": {
            "noShadow": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/onboarding/step-id-upload.tsx",
        "src/components/onboarding/face-verification-card.tsx"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/layout.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/crypto/webauthn-prf.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/privacy/credentials/index.ts",
        "src/lib/privacy/fhe/index.ts",
        "src/lib/privacy/primitives/index.ts",
        "src/lib/privacy/secrets/index.ts",
        "src/lib/privacy/crypto/passkey-vault.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json"
}
